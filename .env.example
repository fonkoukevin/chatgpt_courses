# Configuration locale P01 : chargée par les scripts Node depuis .env.local.
# Valeurs locales non secrètes uniquement ; champs vides à fournir au bon lot.
# Ne jamais committer les fichiers .env réels. Aucun secret NEXT_PUBLIC_*.

APP_ENV=local
APP_PUBLIC_ORIGIN=http://localhost:3000
APP_DEFAULT_LOCALE=fr
# Publication commerciale : aucune langue décidée par ce modèle local.
APP_PUBLISHED_LOCALES=
API_INTERNAL_URL=http://127.0.0.1:8080
API_PORT=8080
API_TIMEOUT_MS=5000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=chatgpt_courses_local
POSTGRES_USER=chatgpt_courses_local
POSTGRES_PASSWORD=

# HTTP local seulement ; true obligatoire en HTTPS recette/production.
SESSION_COOKIE_SECURE=false

MAIL_MODE=local
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_HTTP_PORT=8025
MAIL_SMTP_PORT=1025
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL=false

# Outbox durable : clé Base64 de 32 octets générée par setup:local, jamais publiée.
# Conserver cette même clé lors des redémarrages et avec la sauvegarde privée.
NOTIFICATION_OUTBOX_KEY=
NOTIFICATION_OUTBOX_ENABLED=true
NOTIFICATION_OUTBOX_POLL_DELAY=1s
NOTIFICATION_OUTBOX_LEASE_DURATION=30s
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5
NOTIFICATION_OUTBOX_RETRY_BASE=5s
NOTIFICATION_OUTBOX_RETRY_MAX=5m
NOTIFICATION_OUTBOX_PAYLOAD_RETENTION=24h

# Profil S3 local ; buckets distincts, ACL privées et liens temporaires.
STORAGE_ENABLED=false
S3_ENDPOINT=
S3_EXTERNAL_ENDPOINT=
S3_REGION=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PORT=8333
S3_PATH_STYLE=true
ASSET_MAX_FILE_BYTES=5242880
ASSET_MAX_IMAGE_BYTES=10485760
ASSET_MAX_FILES_PER_PROJECT=10
ASSET_MAX_BYTES_PER_PROJECT=20971520
ASSET_UPLOAD_TTL_SECONDS=300
ASSET_DOWNLOAD_TTL_SECONDS=60
ASSET_MAX_IMAGE_PIXELS=16000000
ASSET_MAX_IMAGE_DIMENSION=4096
ASSET_STAGING_CLEANUP_GRACE_SECONDS=60
ASSET_STAGING_CLEANUP_WORKER_ENABLED=true
ASSET_STAGING_CLEANUP_POLL_DELAY=60s

STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

VIDEO_ENABLED=false
VIDEO_PROVIDER=
VIDEO_API_SECRET=
VIDEO_LOCAL_ROOT=
VIDEO_LINK_TTL_SECONDS=60
VIDEO_MAX_BYTES=20971520

# Garde de vente globale ; les conditions de chaque offre restent obligatoires.
COMMERCE_ENABLED=false
COMMERCE_ALLOWED_CURRENCIES=
COMMERCE_ORDER_TTL=30m
