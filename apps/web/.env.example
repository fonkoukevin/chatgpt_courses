# Copy to apps/web/.env.local for a local development or local production build.
# Next reads this app's .env files, not the repository-root .env.local.
# Server-side settings only. No secrets or NEXT_PUBLIC_* configuration here.
APP_ENV=local
APP_PUBLIC_ORIGIN=http://localhost:3000
APP_DEFAULT_LOCALE=fr
API_INTERNAL_URL=http://127.0.0.1:8080
API_TIMEOUT_MS=30000
