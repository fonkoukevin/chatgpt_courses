# Compose variable names. The root setup command generates .env.local.
# Use the root .env.local explicitly; never print the resolved configuration.
POSTGRES_DB=chatgpt_courses_local
POSTGRES_USER=chatgpt_courses_local
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
MAIL_HTTP_PORT=8025
MAIL_SMTP_PORT=1025
S3_PORT=8333

# The optional s3 profile also requires infra/secrets/s3.local.json.
# That ignored file is generated from the root S3_ACCESS_KEY/S3_SECRET_KEY.
