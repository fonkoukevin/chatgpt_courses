COMPOSE_PROJECT_NAME=courses-staging
APP_ENV=staging
PUBLIC_DOMAIN=staging.example.invalid
APP_PUBLIC_ORIGIN=https://staging.example.invalid
POSTGRES_DB=courses_staging
WEB_IMAGE=
API_IMAGE=
SECRETS_DIR=/srv/chatgpt-courses/staging/secrets
APP_DEFAULT_LOCALE=fr
APP_PUBLISHED_LOCALES=
STAGING_BASIC_USERNAME=reviewer
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# P21 shared-host staging only; dedicated ingress remains the default.
# Uncomment the following pair only after the operator creates the internal bridge
# and persistently connects the existing Caddy to it. No new ingress binds 80/443.
# INGRESS_MODE=shared
# INGRESS_NETWORK=courses-staging-ingress
# Optional isolated Mailpit + private SeaweedFS; requires shared ingress above.
# STAGING_INTEGRATIONS=mailpit-s3
# FILES_PUBLIC_ORIGIN=https://files-staging.example.invalid
# Replace example.invalid: app must use staging.<domain>, files files-staging.<domain>.
# Additional private files below SECRETS_DIR (never put their contents in this file):
# staging-s3-access-key, staging-s3-secret-key, staging-s3-auth.json.
# Auth identity name: courses-staging; one credential matching the two key files.
# Bootstrap verifies exact CORS and unsigned access; video and commerce remain off.
# See ../../docs/runbooks/deploy.md; no buckets or remote services are created here.
