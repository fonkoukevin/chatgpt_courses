{
  "name": "chatgpt-courses",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "services:up": "node scripts/local.mjs up",
    "services:stop": "node scripts/local.mjs stop",
    "services:s3": "node scripts/local.mjs s3",
    "storage:setup": "node scripts/storage-local.mjs",
    "stripe:install": "node scripts/install-stripe-cli.mjs",
    "stripe:check": "node scripts/stripe-local.mjs check",
    "stripe:bindings": "node scripts/check-stripe-binding.mjs",
    "stripe:plan": "node scripts/stripe-local.mjs plan",
    "stripe:secret": "node scripts/stripe-local.mjs secret",
    "stripe:sync-secret": "node scripts/stripe-local.mjs sync-secret",
    "stripe:listen": "node scripts/stripe-local.mjs listen",
    "verify:stripe-config": "node --test tests/scripts/stripe-private-env.test.mjs",
    "video:import": "node scripts/video-import.mjs",
    "services:status": "node scripts/local.mjs status",
    "seed:local": "node scripts/seed-local.mjs",
    "api:validate": "node scripts/api-contract.mjs validate",
    "api:generate": "node scripts/api-contract.mjs generate",
    "api:check": "node scripts/api-contract.mjs check",
    "verify:client": "node scripts/api-contract.mjs test",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/web.mjs dev",
    "dev:api": "node scripts/api.mjs run",
    "start:web": "node scripts/web.mjs start",
    "start:api": "node scripts/api.mjs start",
    "stop": "node scripts/stop.mjs",
    "lint": "npm --workspace @chatgpt-courses/web run lint",
    "typecheck": "npm --workspace @chatgpt-courses/web run typecheck",
    "typecheck:browser": "tsc --project tsconfig.browser.json",
    "build": "npm run build:web",
    "build:web": "node scripts/web.mjs build",
    "build:api": "node scripts/api.mjs verify",
    "verify:api": "node scripts/api.mjs verify",
    "smoke": "node scripts/smoke.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:identity": "node scripts/verify-browser.mjs P04",
    "verify:editorial": "node scripts/verify-browser.mjs P05",
    "verify:public": "node scripts/verify-browser.mjs P06",
    "verify:methods": "node scripts/verify-browser.mjs P07",
    "verify:learning": "node scripts/verify-browser.mjs P08",
    "verify:projects": "node scripts/verify-browser.mjs P09",
    "verify:media": "node scripts/verify-browser.mjs P10",
    "verify:commerce": "node scripts/verify-browser.mjs P11",
    "verify:payments": "node scripts/verify-browser.mjs P12",
    "verify:stripe-test": "node scripts/verify-browser.mjs P12_EXTERNAL",
    "verify:refunds": "node scripts/verify-browser.mjs P13",
    "verify:account": "node scripts/verify-browser.mjs P14",
    "verify:design": "node scripts/verify-browser.mjs P02",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "browser:install": "node scripts/install-browser.mjs",
    "verify:persistence": "node scripts/verify-persistence.mjs"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    },
    "minimatch@^10.2.2": "11.0.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.65.0",
    "@redocly/openapi-core": "2.76.0"
  }
}
